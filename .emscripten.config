# Emscripten configuration for Redline Game
# Copy this file to ~/.emscripten.config or use with --em-config flag

# Compiler optimization level
# Possible values: 0, 1, 2, 3, s, z
# For production, use 3
# For development/debugging, use 0
EMCC_OPTIMIZATION_LEVEL = 3

# Memory settings
INITIAL_MEMORY = 67108864  # 64MB
ALLOW_MEMORY_GROWTH = 1
TOTAL_STACK = 4194304      # 4MB

# WebAssembly settings
WASM = 1
WASM_ASYNC_COMPILATION = 1

# Include assertions in debug builds
ASSERTIONS = 0

# Export ES6 modules for better tree-shaking
MODULARIZE = 0
EXPORT_ES6 = 0

# Enable exception catching
DISABLE_EXCEPTION_CATCHING = 0

# Filesystem settings
FORCE_FILESYSTEM = 1

# Graphics settings
USE_SDL = 2
USE_SDL_IMAGE = 2
SDL2_IMAGE_FORMATS = ["png"]

# Audio settings
USE_SDL_MIXER = 0

# Network settings (disable for games that don't need network)
WEBSOCKET_URL = ''
FETCH = 0

# Keep console output clean
DISABLE_DEPRECATED_FIND_EVENT_TARGET_BEHAVIOR = 1

# Browser environment only (not Node.js)
ENVIRONMENT = 'web'

# Debugging features
CYBERDWARF = 0
EMSCRIPTEN_TRACING = 0

# Profiling features
EMPROFILE_HEAP = 0

# Runtime performance options
NO_FILESYSTEM = 0
INVOKE_RUN = 1
EXIT_RUNTIME = 0
PTHREAD_POOL_SIZE = 0

# Advanced optimization
ELIMINATE_DUPLICATE_FUNCTIONS = 1
ELIMINATE_DUPLICATE_FUNCTIONS_PASSES = 5
ALIASING_FUNCTION_POINTERS = 1

# Compression for network transfer (not for storage)
BINARYEN_ASYNC_COMPILATION = 1
WASM_OBJECT_FILES = 1

# Path to shell file (HTML template)
SHELL_FILE = "shell.html"