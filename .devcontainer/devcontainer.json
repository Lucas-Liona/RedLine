{
    "name": "Redline Game Environment",
    "image": "mcr.microsoft.com/devcontainers/cpp:debian",
    "features": {},
    "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
    "onCreateCommand": "apt-get update && apt-get install -y libsdl2-dev libsdl2-image-dev",
    "postCreateCommand": "make",
    "settings": {
        "editor.formatOnSave": true
    },
    "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
    ],
    "forwardPorts": [5901],
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/redline,type=bind",
    "workspaceFolder": "/workspaces/redline"
}
